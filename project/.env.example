OPENROUTER_API_KEY=your_openrouter_key
VIRUSTOTAL_API_KEY=your_virustotal_key

# V3 additions
YARAIFY_AUTH_KEY=your_yaraify_auth_key_here
MALWAREBAZAAR_AUTH_KEY=your_malwarebazaar_auth_key_here
# REQUIRED: the server refuses to start if these are missing, too short, or placeholder values.
# ADMIN_PIN: SOC portal login, 6+ characters   (openssl rand -hex 4)
# ADMIN_API_KEY / API_KEY: 16+ characters, different from each other   (openssl rand -hex 16)
ADMIN_PIN=
ADMIN_API_KEY=
API_KEY=
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# Deployment (optional)
# PORT=5000
# HOST=127.0.0.1                 # bind address; leave empty for all interfaces (Docker)
# SERVER_URL=https://threatlens.example.internal   # public URL, used in report links
# TRUST_PROXY=loopback           # behind a proxy on the same host ("1" for one hop, e.g. Docker network)
# ALLOWED_ORIGINS=https://threatlens.example.internal   # only if UI and API are on different origins
